<Page
    x:Class="QuietMonitor.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource Ink}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="18">
            <StackPanel Spacing="4">
                <TextBlock Text="Overlay settings" Foreground="{StaticResource Paper}" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Changes apply to the pinned widget automatically." Foreground="{StaticResource Muted}" FontSize="13" />
            </StackPanel>

            <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="18">
                <StackPanel Spacing="15">
                    <TextBlock Text="Appearance" Foreground="{StaticResource Paper}" FontSize="18" FontWeight="SemiBold" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Opacity" Foreground="{StaticResource Paper}" FontWeight="SemiBold" /><TextBlock x:Name="OpacityValue" Text="90%" Foreground="{StaticResource Muted}" FontSize="12" /></StackPanel>
                        <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="55" Maximum="100" StepFrequency="5" ValueChanged="OpacityChanged" AutomationProperties.Name="Overlay opacity" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Refresh interval" Foreground="{StaticResource Paper}" FontWeight="SemiBold" /><TextBlock Text="Slower updates use fewer resources." Foreground="{StaticResource Muted}" FontSize="12" /></StackPanel>
                        <ComboBox x:Name="RefreshCombo" Grid.Column="1" AutomationProperties.Name="Refresh interval">
                            <ComboBoxItem Content="0.5 seconds" Tag="500" /><ComboBoxItem Content="1 second" Tag="1000" /><ComboBoxItem Content="2 seconds" Tag="2000" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Visible readings" Foreground="{StaticResource Paper}" FontSize="18" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="20" RowSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <CheckBox x:Name="CpuLoadCheck" Content="CPU load" Foreground="{StaticResource Paper}" />
                        <CheckBox x:Name="CpuTemperatureCheck" Grid.Column="1" Content="CPU temperature" Foreground="{StaticResource Paper}" />
                        <CheckBox x:Name="GpuLoadCheck" Grid.Row="1" Content="GPU load" Foreground="{StaticResource Paper}" />
                        <CheckBox x:Name="GpuTemperatureCheck" Grid.Row="1" Grid.Column="1" Content="GPU temperature" Foreground="{StaticResource Paper}" />
                        <CheckBox x:Name="GpuHotspotCheck" Grid.Row="2" Content="GPU hotspot" Foreground="{StaticResource Paper}" />
                        <CheckBox x:Name="GpuPowerCheck" Grid.Row="2" Grid.Column="1" Content="GPU power" Foreground="{StaticResource Paper}" />
                        <CheckBox x:Name="GpuFanCheck" Grid.Row="3" Content="GPU fan" Foreground="{StaticResource Paper}" />
                        <CheckBox x:Name="MemoryCheck" Grid.Row="3" Grid.Column="1" Content="Memory" Foreground="{StaticResource Paper}" />
                        <CheckBox x:Name="VramCheck" Grid.Row="4" Content="Video memory" Foreground="{StaticResource Paper}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#17251F" BorderBrush="#496B5C" BorderThickness="1" CornerRadius="10" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Stops when the widget closes" Foreground="#BCE8D6" FontWeight="SemiBold" />
                    <TextBlock Text="The sensor broker runs only while the widget sends a heartbeat. It exits automatically within a few seconds after the widget is closed or unpinned and hidden." Foreground="#A7C9BC" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid>
                <TextBlock x:Name="StatusText" Foreground="#6FD4B0" VerticalAlignment="Center" />
                <Button Content="Save changes" HorizontalAlignment="Right" Background="{StaticResource Blue}" Foreground="#08111D" FontWeight="SemiBold" Padding="18,9" Click="SaveClicked" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
