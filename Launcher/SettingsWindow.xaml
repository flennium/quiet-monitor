<Window x:Class="QuietMonitor.Launcher.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Quiet Monitor" Width="940" Height="780" MinWidth="820" MinHeight="680" Background="{DynamicResource Ink}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI Variable Text" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
   <Grid Margin="24,28,24,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><Grid Width="54" Height="54" HorizontalAlignment="Left"><Ellipse Fill="{DynamicResource Accent}"/><Path Stroke="{DynamicResource AccentInk}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 11,29 C 16,18 22,18 27,29 C 32,40 38,40 43,29"/></Grid><TextBlock Text="Quiet Monitor" FontFamily="Segoe UI Variable Display" FontSize="24" FontWeight="SemiBold" Margin="0,14,0,4"/><TextBlock Text="Signal when you need it. Silence when you don't." Foreground="{DynamicResource Muted}" FontSize="13" TextWrapping="Wrap" LineHeight="19"/></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,34,0,0"><TextBlock Text="SECTIONS ON THIS PAGE" Foreground="{DynamicResource Muted}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Launch" Margin="0,14,0,6" Foreground="{DynamicResource Muted}" FontSize="13"/><TextBlock Text="Appearance" Margin="0,7,0,6" Foreground="{DynamicResource Muted}" FontSize="13"/><TextBlock Text="Readings" Margin="0,7,0,6" Foreground="{DynamicResource Muted}" FontSize="13"/></StackPanel>
    <StackPanel Grid.Row="2"><TextBlock Text="No startup entry" Foreground="{DynamicResource Good}" FontSize="12"/><TextBlock Text="No service · No injection" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="34,30,34,20"><TextBlock Text="Control center" FontFamily="Segoe UI Variable Display" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="One place for the desktop overlay and Xbox Game Bar widget." Foreground="{DynamicResource Muted}" FontSize="14" Margin="0,5,0,0"/></StackPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="34,0,34,26">
    <TextBlock Text="Launch" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,12"/>
    <Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="20"><StackPanel>
     <CheckBox x:Name="PreferGameBarCheck" Content="Use Xbox Game Bar when available"/><TextBlock Text="Best for fullscreen games. The desktop overlay takes over automatically when Game Bar is unavailable." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="26,7,0,16"/>
     <Border Background="{DynamicResource Raised}" CornerRadius="10" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource Good}" VerticalAlignment="Center" Margin="0,0,11,0"/><StackPanel Grid.Column="1"><TextBlock Text="Xbox Game Bar" FontWeight="SemiBold"/><TextBlock x:Name="GameBarStatus" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0" AutomationProperties.Name="Xbox Game Bar status"/></StackPanel></Grid></Border>
     <StackPanel Margin="0,18,0,0"><TextBlock Text="Show or hide shortcut" FontWeight="SemiBold"/><TextBlock Text="Click the shortcut below, then press a key combination. Press Escape to cancel. Windows handles it with no resident hotkey process." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/><StackPanel Orientation="Horizontal"><Button x:Name="HotkeyRecordButton" Content="Ctrl + Alt + Q" Style="{StaticResource SecondaryButton}" MinWidth="145" Click="RecordHotkey_Click" AutomationProperties.Name="Record show or hide shortcut" AutomationProperties.HelpText="Press Ctrl, Alt, or Shift with a letter, number, or function key. Press Escape to cancel."/><Button x:Name="ClearHotkeyButton" Content="Clear" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ClearHotkey_Click" AutomationProperties.Name="Disable show or hide shortcut"/></StackPanel><TextBlock x:Name="HotkeyFeedbackText" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,9,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></StackPanel>
    </StackPanel></Border>
    <TextBlock Text="Appearance" FontSize="19" FontWeight="SemiBold" Margin="0,26,0,12"/>
    <Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="20"><StackPanel>
     <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="App theme" FontWeight="SemiBold"/><TextBlock Text="Follows Windows by default." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel><ComboBox x:Name="ThemeCombo" Grid.Column="1" SelectionChanged="ThemeChanged" AutomationProperties.Name="App theme"><ComboBoxItem Content="Use Windows setting" Tag="System"/><ComboBoxItem Content="Dark" Tag="Dark"/><ComboBoxItem Content="Light" Tag="Light"/></ComboBox></Grid>
     <Grid Margin="0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock Text="Desktop position" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="PositionCombo" Grid.Column="1" AutomationProperties.Name="Desktop overlay position"><ComboBoxItem Content="Top right" Tag="TopRight"/><ComboBoxItem Content="Top left" Tag="TopLeft"/><ComboBoxItem Content="Bottom right" Tag="BottomRight"/><ComboBoxItem Content="Bottom left" Tag="BottomLeft"/></ComboBox></Grid>
     <Grid Margin="0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock Text="Overlay size" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="ScaleCombo" Grid.Column="1" AutomationProperties.Name="Desktop overlay size"><ComboBoxItem Content="Compact" Tag="0.85"/><ComboBoxItem Content="Balanced" Tag="1"/><ComboBoxItem Content="Large" Tag="1.2"/></ComboBox></Grid>
     <Grid Margin="0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Opacity" FontWeight="SemiBold"/><TextBlock x:Name="OpacityValueText" Foreground="{DynamicResource Muted}" FontSize="12"/></StackPanel><Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="55" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OpacityChanged" AutomationProperties.Name="Overlay opacity" AutomationProperties.HelpText="Choose an opacity from 55 to 100 percent"/></Grid>
     <Grid Margin="0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock Text="Refresh interval" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="RefreshCombo" Grid.Column="1" AutomationProperties.Name="Overlay refresh interval"><ComboBoxItem Content="0.5 seconds" Tag="500"/><ComboBoxItem Content="1 second" Tag="1000"/><ComboBoxItem Content="2 seconds" Tag="2000"/></ComboBox></Grid>
    </StackPanel></Border>
    <TextBlock Text="Visible readings" FontSize="19" FontWeight="SemiBold" Margin="0,26,0,12"/>
    <Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="20"><UniformGrid Columns="3"><CheckBox x:Name="CpuLoadCheck" Content="CPU load" Margin="0,7"/><CheckBox x:Name="CpuTemperatureCheck" Content="CPU temperature" Margin="0,7"/><CheckBox x:Name="MemoryCheck" Content="Memory" Margin="0,7"/><CheckBox x:Name="GpuLoadCheck" Content="GPU load" Margin="0,7"/><CheckBox x:Name="GpuTemperatureCheck" Content="GPU temperature" Margin="0,7"/><CheckBox x:Name="GpuHotspotCheck" Content="GPU hotspot" Margin="0,7"/><CheckBox x:Name="GpuPowerCheck" Content="GPU power" Margin="0,7"/><CheckBox x:Name="GpuFanCheck" Content="GPU fan" Margin="0,7"/><CheckBox x:Name="VramCheck" Content="Video memory" Margin="0,7"/></UniformGrid></Border>
    <TextBlock x:Name="FeedbackText" Foreground="{DynamicResource Good}" Margin="2,16,0,0" TextWrapping="Wrap"/>
   </StackPanel></ScrollViewer>
   <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="34,15"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Close" Style="{StaticResource SecondaryButton}" Click="Close_Click" IsCancel="True" Margin="0,0,9,0"/><Button Content="Save" Style="{StaticResource SecondaryButton}" Click="Save_Click" IsDefault="True" Margin="0,0,9,0"/><Button Content="Save and open monitor" Click="OpenMonitor_Click"/></StackPanel></Border>
  </Grid>
 </Grid>
</Window>
