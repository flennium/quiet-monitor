<Window x:Class="QuietMonitor.Launcher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiet Monitor settings" Width="620" Height="460" ResizeMode="NoResize"
        Background="{StaticResource Ink}" WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Launch mode" FontFamily="Segoe UI Variable Display" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="Choose how Quiet Monitor appears over your games." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,26,0,0">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="22">
                <StackPanel>
                    <CheckBox x:Name="PreferGameBarCheck" Content="Use Xbox Game Bar when available" IsChecked="True" Checked="PreferenceChanged" Unchecked="PreferenceChanged" />
                    <TextBlock Text="Best for fullscreen games. Quiet Monitor opens Game Bar, where you can select and pin the widget. This is enabled by default." Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="19" Margin="26,9,0,0" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Xbox Game Bar" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock x:Name="GameBarStatus" Foreground="{StaticResource Muted}" Margin="0,5,0,0" />
                    </StackPanel>
                    <Ellipse x:Name="StatusDot" Grid.Column="1" Width="10" Height="10" VerticalAlignment="Center" Fill="#6FD4B0" />
                </Grid>
            </Border>
            <TextBlock x:Name="FeedbackText" Foreground="#6FD4B0" Margin="2,15,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="2">
            <TextBlock Text="No startup entry · No service · No game injection" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Background="#253243" Click="Close_Click" Margin="0,0,10,0" />
                <Button Content="Open monitor" Click="OpenMonitor_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
