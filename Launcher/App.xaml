<Application x:Class="QuietMonitor.Launcher.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#09111B"/><SolidColorBrush x:Key="Panel" Color="#101C29"/><SolidColorBrush x:Key="Raised" Color="#172638"/><SolidColorBrush x:Key="Line" Color="#2B4055"/><SolidColorBrush x:Key="Text" Color="#F4F8FB"/><SolidColorBrush x:Key="Muted" Color="#A8BAC9"/><SolidColorBrush x:Key="Accent" Color="#59D6E7"/><SolidColorBrush x:Key="AccentInk" Color="#051317"/><SolidColorBrush x:Key="Good" Color="#73D9B2"/><SolidColorBrush x:Key="Warning" Color="#F4BF62"/><SolidColorBrush x:Key="ControlSurface" Color="#172638"/><SolidColorBrush x:Key="ControlText" Color="#F4F8FB"/>
    <Style TargetType="Button"><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="17,10"/><Setter Property="FontFamily" Value="Segoe UI Variable Text"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="SecondaryButton" TargetType="Button"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Raised}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,9"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FontFamily" Value="Segoe UI Variable Text"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{DynamicResource ControlText}"/><Setter Property="Background" Value="{DynamicResource ControlSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Padding" Value="9,6"/></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource ControlText}"/><Setter Property="Background" Value="{DynamicResource ControlSurface}"/><Setter Property="Padding" Value="9,6"/></Style>
  </Application.Resources>
</Application>
