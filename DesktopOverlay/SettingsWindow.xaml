<Window x:Class="QuietMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiet Monitor settings" Width="760" Height="690" MinWidth="680" MinHeight="620"
        Background="{StaticResource Ink}" WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,10" />
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="22" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="30">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Overlay settings" FontFamily="Segoe UI Variable Display" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="Tune what stays visible without adding a background service or game injection." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,5,0,0" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,26,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="270" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="Placement" Style="{StaticResource SectionTitle}" />
                            <Grid Style="{StaticResource SettingRow}" Margin="0,18,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Screen corner" Style="{StaticResource SettingLabel}" />
                                <ComboBox x:Name="PositionCombo" Grid.Column="1" AutomationProperties.Name="Overlay screen corner">
                                    <ComboBoxItem Content="Top right" Tag="TopRight" /><ComboBoxItem Content="Top left" Tag="TopLeft" />
                                    <ComboBoxItem Content="Bottom right" Tag="BottomRight" /><ComboBoxItem Content="Bottom left" Tag="BottomLeft" />
                                </ComboBox>
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Size" Style="{StaticResource SettingLabel}" />
                                <ComboBox x:Name="ScaleCombo" Grid.Column="1" AutomationProperties.Name="Overlay size">
                                    <ComboBoxItem Content="Compact" Tag="0.85" /><ComboBoxItem Content="Balanced" Tag="1.0" /><ComboBoxItem Content="Large" Tag="1.2" />
                                </ComboBox>
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Opacity" Style="{StaticResource SettingLabel}" /><TextBlock x:Name="OpacityValueText" Text="90%" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
                                <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="55" Maximum="100" Value="90" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OpacitySlider_ValueChanged" AutomationProperties.Name="Overlay opacity" />
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Refresh rate" Style="{StaticResource SettingLabel}" />
                                <ComboBox x:Name="RefreshCombo" Grid.Column="1" AutomationProperties.Name="Sensor refresh rate">
                                    <ComboBoxItem Content="0.5 seconds" Tag="500" /><ComboBoxItem Content="1 second" Tag="1000" /><ComboBoxItem Content="2 seconds" Tag="2000" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource PanelCard}" Background="#121923">
                        <StackPanel>
                            <TextBlock Text="Preview" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,14" />
                            <Border Background="#E6111720" BorderBrush="#405064" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <Border Height="3" Background="{StaticResource Blue}" CornerRadius="2" Margin="0,0,0,10" />
                                    <Grid><TextBlock Text="CPU" Foreground="#AEB9C7" FontSize="12" /><TextBlock Text="42%" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid>
                                    <Grid Margin="0,7,0,0"><TextBlock Text="GPU" Foreground="#AEB9C7" FontSize="12" /><TextBlock Text="78%" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid>
                                    <Grid Margin="0,7,0,0"><TextBlock Text="GPU temp" Foreground="#AEB9C7" FontSize="12" /><TextBlock Text="68 °C" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid>
                                    <Grid Margin="0,7,0,0"><TextBlock Text="Memory" Foreground="#AEB9C7" FontSize="12" /><TextBlock Text="8.6 / 15.8 GB" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="The real overlay is click-through and never takes focus from your game." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource PanelCard}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Visible readings" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                        <UniformGrid Columns="3">
                            <CheckBox x:Name="CpuLoadCheck" Content="CPU load" Margin="0,8" />
                            <CheckBox x:Name="CpuTemperatureCheck" Content="CPU temperature" Margin="0,8" />
                            <CheckBox x:Name="MemoryCheck" Content="Memory" Margin="0,8" />
                            <CheckBox x:Name="GpuLoadCheck" Content="GPU load" Margin="0,8" />
                            <CheckBox x:Name="GpuTemperatureCheck" Content="GPU temperature" Margin="0,8" />
                            <CheckBox x:Name="GpuHotspotCheck" Content="GPU hotspot" Margin="0,8" />
                            <CheckBox x:Name="GpuPowerCheck" Content="GPU power" Margin="0,8" />
                            <CheckBox x:Name="GpuFanCheck" Content="GPU fan" Margin="0,8" />
                            <CheckBox x:Name="VramCheck" Content="Video memory" Margin="0,8" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource PanelCard}" Margin="0,16,0,8">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Background="#6FD4B0" CornerRadius="2" />
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="Safe overlay mode" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="No DLL injection, game hooks, service, tray process, or startup entry. Use borderless fullscreen for reliable visibility; exclusive fullscreen is not supported." Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="19" Margin="0,7,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="1" Background="#151C26" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <TextBlock x:Name="StatusText" Foreground="#6FD4B0" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Stop overlay" Style="{StaticResource QuietButton}" Click="StopOverlay_Click" Margin="0,0,10,0" />
                    <Button Content="Save changes" Style="{StaticResource PrimaryButton}" Click="SaveChanges_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
