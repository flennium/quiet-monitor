<Application
    x:Class="QuietMonitor.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="InkColor">#10151D</Color>
            <Color x:Key="PanelColor">#171E28</Color>
            <Color x:Key="RaisedColor">#202936</Color>
            <Color x:Key="LineColor">#334155</Color>
            <Color x:Key="PaperColor">#F3F0E8</Color>
            <Color x:Key="MutedColor">#AAB4C2</Color>
            <Color x:Key="BlueColor">#60A5FA</Color>
            <Color x:Key="AmberColor">#F2B84B</Color>
            <Color x:Key="CoralColor">#F07167</Color>
            <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
            <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}" />
            <SolidColorBrush x:Key="Raised" Color="{StaticResource RaisedColor}" />
            <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
            <SolidColorBrush x:Key="Paper" Color="{StaticResource PaperColor}" />
            <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
            <SolidColorBrush x:Key="Blue" Color="{StaticResource BlueColor}" />
            <SolidColorBrush x:Key="Amber" Color="{StaticResource AmberColor}" />
            <SolidColorBrush x:Key="Coral" Color="{StaticResource CoralColor}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
