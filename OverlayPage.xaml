<Page
    x:Class="QuietMonitor.OverlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Page.Resources>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Paper}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MetricRow" TargetType="Grid">
            <Setter Property="Height" Value="30" />
        </Style>
    </Page.Resources>

    <Grid Padding="10">
        <Border x:Name="Surface" Background="#E6111720" BorderBrush="#6641556B" BorderThickness="1" CornerRadius="8" Padding="15,12">
            <StackPanel>
                <Border Height="3" Background="{StaticResource Blue}" CornerRadius="2" Margin="0,0,0,12" />
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Quiet Monitor" Foreground="{StaticResource Paper}" FontFamily="Segoe UI Variable Display" FontSize="14" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="#6FD4B0" Margin="0,0,7,0" />
                        <TextBlock x:Name="LiveText" Text="Live" Foreground="{StaticResource Muted}" FontSize="12" />
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,5" />
                <Grid x:Name="CpuLoadRow" Style="{StaticResource MetricRow}"><TextBlock Text="CPU" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="CpuLoadText" Text="—" Style="{StaticResource MetricValue}" /></Grid>
                <Grid x:Name="CpuTemperatureRow" Style="{StaticResource MetricRow}"><TextBlock Text="CPU temperature" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="CpuTemperatureText" Text="—" Style="{StaticResource MetricValue}" /></Grid>
                <Grid x:Name="GpuLoadRow" Style="{StaticResource MetricRow}"><TextBlock Text="GPU" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="GpuLoadText" Text="—" Style="{StaticResource MetricValue}" /></Grid>
                <Grid x:Name="GpuTemperatureRow" Style="{StaticResource MetricRow}"><TextBlock Text="GPU temperature" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="GpuTemperatureText" Text="—" Style="{StaticResource MetricValue}" /></Grid>
                <Grid x:Name="GpuHotspotRow" Style="{StaticResource MetricRow}"><TextBlock Text="GPU hotspot" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="GpuHotspotText" Text="—" Style="{StaticResource MetricValue}" /></Grid>
                <Grid x:Name="GpuPowerRow" Style="{StaticResource MetricRow}"><TextBlock Text="GPU power" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="GpuPowerText" Text="—" Style="{StaticResource MetricValue}" /></Grid>
                <Grid x:Name="GpuFanRow" Style="{StaticResource MetricRow}"><TextBlock Text="GPU fan" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="GpuFanText" Text="—" Style="{StaticResource MetricValue}" /></Grid>
                <Grid x:Name="MemoryRow" Style="{StaticResource MetricRow}"><TextBlock Text="Memory" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="MemoryText" Text="—" Style="{StaticResource MetricValue}" /></Grid>
                <Grid x:Name="VramRow" Style="{StaticResource MetricRow}"><TextBlock Text="VRAM" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="VramText" Text="—" Style="{StaticResource MetricValue}" /></Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
